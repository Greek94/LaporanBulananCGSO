function setupDatabase() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) throw new Error('Spreadsheet tidak dapat dikenal pasti.');

  Object.keys(SETUP_HEADERS).forEach(function(name) {
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    const headers = SETUP_HEADERS[name];
    if (sh.getLastRow() === 0) {
      sh.getRange(1,1,1,headers.length).setValues([headers]);
    } else {
      const current = sh.getRange(1,1,1,Math.max(sh.getLastColumn(),headers.length)).getValues()[0];
      headers.forEach(function(h,i) {
        if (String(current[i] || '').trim() !== h) sh.getRange(1,i+1).setValue(h);
      });
    }
  });

  seedRows_('ORGANISATIONS', SETUP_HEADERS.ORGANISATIONS, SETUP_ORGS, 'OrganisationID');
  seedRows_('USERS', SETUP_HEADERS.USERS, SETUP_USERS.map(function(r){ return r.concat(['','','']); }), 'UserID');
  seedRows_('REPORT_ITEMS', SETUP_HEADERS.REPORT_ITEMS, SETUP_ITEMS, 'ItemCode');
  seedRows_('ORGANISATION_MODULE_ACCESS', SETUP_HEADERS.ORGANISATION_MODULE_ACCESS, SETUP_MODULES, 'OrganisationID|ModuleCode');
  seedRows_('ORGANISATION_ITEM_ACCESS', SETUP_HEADERS.ORGANISATION_ITEM_ACCESS, SETUP_ACCESS.filter(function(r){ return r[1] !== '9.2' || r[0] === 'ORG004'; }), 'OrganisationID|ItemCode');

  upsertConfig_('REPORT_CLOSE_DAY','7','Hari tutup laporan pada bulan berikutnya.');
  upsertConfig_('CURRENT_PERIOD','2026-09','Tempoh semasa semasa deployment awal; fungsi sistem menentukan tempoh berdasarkan tarikh.');

  verifyDatabase();
  return {ok:true, message:'Database setup selesai tanpa memadam data sedia ada.'};
}

function seedRows_(sheetName, headers, rows, keySpec) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName);
  const values = sh.getDataRange().getValues();
  const idx = {};
  headers.forEach(function(h,i){idx[h]=i;});
  const keyParts = keySpec.split('|');
  const existing = {};
  for (let i=1;i<values.length;i++) {
    const key = keyParts.map(function(k){return String(values[i][idx[k]] || '').trim().toUpperCase();}).join('|');
    if (key !== '') existing[key]=true;
  }
  const toWrite=[];
  rows.forEach(function(row){
    const key = keyParts.map(function(k){
      const pos=headers.indexOf(k);
      return String(pos>=0 ? (row[pos] || '') : '').trim().toUpperCase();
    }).join('|');
    if (!key || existing[key]) return;
    const out=new Array(headers.length).fill('');
    row.forEach(function(v,i){if(i<out.length) out[i]=v;});
    toWrite.push(out); existing[key]=true;
  });
  if (toWrite.length) sh.getRange(sh.getLastRow()+1,1,toWrite.length,headers.length).setValues(toWrite);
}

function upsertConfig_(key,value,description){
  const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName('CONFIG');
  const vals=sh.getDataRange().getValues();
  for(let i=1;i<vals.length;i++){
    if(String(vals[i][0]||'').trim()===key){
      sh.getRange(i+1,2,1,2).setValues([[value,description]]);
      return;
    }
  }
  sh.appendRow([key,value,description]);
}

function verifyDatabase(){
  const ss=SpreadsheetApp.getActiveSpreadsheet();
  const required=Object.keys(SETUP_HEADERS);
  const missing=required.filter(function(n){return !ss.getSheetByName(n);});
  const orgSheet=ss.getSheetByName('ORGANISATIONS');
  const reportSheet=ss.getSheetByName('REPORTS');
  const orgCount=orgSheet ? Math.max(0,orgSheet.getLastRow()-1) : 0;
  const reportCount=reportSheet ? Math.max(0,reportSheet.getLastRow()-1) : 0;
  return {ok:missing.length===0, missingSheets:missing, organisationCount:orgCount, reportCount:reportCount};
}

function seedCurrentPeriodOnly(){
  // Deliberately does not create reports. Creates 2026-09 period only if absent.
  const ss=SpreadsheetApp.getActiveSpreadsheet();
  const sh=ss.getSheetByName('REPORT_PERIODS');
  if(!sh) throw new Error('REPORT_PERIODS belum wujud. Jalankan setupDatabase().');
  const pid='2026-09';
  const vals=sh.getDataRange().getValues();
  for(let i=1;i<vals.length;i++){if(String(vals[i][0]||'')===pid)return {ok:true,created:false,periodId:pid};}
  const open=new Date(2026,8,1,0,0,0);
  const close=new Date(2026,9,7,23,59,59);
  sh.appendRow([pid,9,2026,open,close,'OPEN',new Date()]);
  return {ok:true,created:true,periodId:pid};
}
